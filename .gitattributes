* text=auto
*.c text eol=lf
*.h text eol=lf
Makefile text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pptx binary
*.docx binary
*.zip binary

# Preserve archived reference bytes for manifest verification.
legacy/** -text whitespace=cr-at-eol

# Fixed-width grid exports require trailing cells; ANSI exports preserve bytes.
docs/design/*.txt -whitespace
*.ans -text -diff
